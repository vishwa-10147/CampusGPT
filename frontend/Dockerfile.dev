# ==============================================================================
# CampusGPT Frontend — Development Dockerfile
# ==============================================================================
FROM node:20-alpine

# System Chromium for Playwright e2e tests (Playwright's own builds don't support Alpine)
RUN apk add --no-cache chromium

# Set working directory
WORKDIR /app

# Install dependencies first (better caching)
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]