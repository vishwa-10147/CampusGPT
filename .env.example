# ==============================================================================
# CampusGPT — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/campusgpt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campusgpt

# ------------------------------------------------------------------------------
# Security (CHANGE THESE IN PRODUCTION!)
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id password hashing parameters
# Higher = more secure but slower. These are reasonable defaults.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Choose ONE provider: openai, anthropic, or local
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Local (Ollama, LM Studio, vLLM, etc.) ---
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=llama3.1:8b
# LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# File Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=10

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# RAG Configuration
# ------------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7
MAX_CONTEXT_CHUNKS=3

# ------------------------------------------------------------------------------
# Web Scraping / Ingestion
# ------------------------------------------------------------------------------
# mgit.ac.in scraping
MGIT_BASE_URL=https://mgit.ac.in
MGIT_SCRAPE_DELAY_SECONDS=2
MGIT_MAX_PAGES=100
MGIT_ALLOWED_PATHS=/about,/admissions,/academics,/departments,/placements,/notices,/events

# General scraping
SCRAPER_USER_AGENT=CampusGPT-Ingestion-Bot/1.0 (+https://your-college.edu/bot)
SCRAPER_RESPECT_ROBOTS_TXT=true
SCRAPER_MAX_CONCURRENT=3